{
  "name": "archai",
  "version": "0.2.2",
  "private": true,
  "description": "ArchAI - a source-available, command-driven architectural workspace: plans, 3D, sheets, rendering, VR and plugins",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Hussein5645 (https://github.com/Hussein5645)",
  "homepage": "https://github.com/Hussein5645/archai-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hussein5645/archai-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Hussein5645/archai-studio/issues"
  },
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "desktop": "node scripts/desktop.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog:dev": "node scripts/build-dev-catalog.mjs",
    "catalog:cai": "node scripts/build-cai-catalog.mjs",
    "catalog:samples": "node scripts/make-sample-system-types.mjs"
  },
  "dependencies": {
    "@tarikjabiri/dxf": "^2.9.0",
    "@types/three": "^0.186.0",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "manifold-3d": "^3.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.0",
    "three-gpu-pathtracer": "^0.0.26",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dxf-parser": "^1.1.2",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.149.0"
  },
  "build": {
    "appId": "app.archai.desktop",
    "buildVersion": "0.2.2.16",
    "productName": "ArchAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/electron/**/*",
      "dist-electron/shared/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "ArchAI",
        "schemes": [
          "archai"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ArchAI-Setup-${version}.${ext}"
    }
  }
}
