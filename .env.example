# Copy to .env.local to override defaults; none of these are required for development.

# The ArchAI cloud (workers/archai-cloud). Defaults to the hosted service; for a local
# `wrangler dev` use /__cloud with ARCHAI_LOCAL_CLOUD=http://127.0.0.1:8787 (see README).
# VITE_CLOUD_URL=https://archai-cloud.example.workers.dev

# Who people email to get an account (shown in the sign-in dialog).
# VITE_ACCOUNT_CONTACT=you@example.com

# The VR share service (workers/vr-share).
# VITE_VR_SHARE_URL=https://archai-vr-share.example.workers.dev
