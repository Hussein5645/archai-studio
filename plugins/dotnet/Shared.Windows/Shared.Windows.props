<Project>
  <!-- Import into a Windows plugin project: the shared WPF UI, the icon set and the plugin core. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)ArchaiWindows.cs" Link="Shared\ArchaiWindows.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\icons\png\*.png" LogicalName="archai.%(Filename)%(Extension)" Link="Icons\%(Filename)%(Extension)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Archai.Plugins.Core\Archai.Plugins.Core.csproj" />
  </ItemGroup>
</Project>
