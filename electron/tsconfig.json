{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "../dist-electron",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.cts", "../shared/**/*.ts"],
  "exclude": ["../shared/**/*.test.ts"]
}
