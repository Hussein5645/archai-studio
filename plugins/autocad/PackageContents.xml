    ProductCode="{B3E1F6A2-7C4D-4A8B-9E2F-0D6C1A5B7E31}" UpgradeCode="{5A9C2E7B-1F3D-4C6A-8B0E-2D7F4A1C9E53}" Icon="./Contents/logo.ico">
